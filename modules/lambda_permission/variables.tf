variable "lambda_permission_action" {
  description = "(Required) Lambda action to allow in this statement (e.g., lambda:InvokeFunction)"
  type        = string
}
variable "lambda_permission_event_source_token" {
  description = "(Optional) Event Source Token for Alexa Skills"
  type        = string
  default     = null
}
variable "lambda_permission_function_name" {
  description = "(Required) Name or ARN of the Lambda function"
  type        = string
}
variable "lambda_permission_function_url_auth_type" {
  description = "(Optional) Lambda Function URL authentication type. Valid values: AWS_IAM or NONE. Only valid with lambda:InvokeFunctionUrl action"
  type        = string
  default     = null
}
variable "lambda_permission_invoked_via_function_url" {
  description = "(Optional) Lambda Function URL invoke permission. Only valid with lambda:InvokeFunction action"
  type        = bool
  default     = null
}
variable "lambda_permission_principal" {
  description = "(Required) AWS service or account that invokes the function (e.g., s3.amazonaws.com, sns.amazonaws.com, AWS account ID, or AWS IAM principal)"
  type        = string
  default     = null
}
variable "lambda_permission_principal_org_id" {
  description = "(Optional) AWS Organizations ID to grant permission to all accounts under this organization"
  type        = string
  default     = null
}
variable "lambda_permission_qualifier" {
  description = " (Optional) Lambda function version or alias name"
  type        = string
  default     = null
}
variable "lambda_permission_source_account" {
  description = "(Optional) AWS account ID of the source owner for cross-account access, S3, or SES"
  type        = string
  default     = null
}
variable "lambda_permission_source_arn" {
  description = "(Optional) ARN of the source resource granting permission to invoke the Lambda function"
  type        = string
  default     = null
}
variable "lambda_permission_statement_id" {
  description = "(Optional) Statement identifier. Generated by Terraform if not provided"
  type        = string
  default     = null
}
variable "lambda_permission_statement_id_prefix" {
  description = "(Optional) Statement identifier prefix. Conflicts with statement_id"
  type        = string
  default     = null
}
