output "api_gateway_documentation_part_documentation_part_id" {
  description = "DocumentationPart identifier, generated by API Gateway when the documentation part is created"
  value       = element(concat(aws_api_gateway_documentation_part.api_gateway_documentation_part.*.documentation_part_id, [""]), 0)
}
output "api_gateway_documentation_part_id" {
  description = "Unique ID of the Documentation Part"
  value       = element(concat(aws_api_gateway_documentation_part.api_gateway_documentation_part.*.id, [""]), 0)
}
