output "iam_service_specific_credential_id" {
  description = "The combination of service_name and user_name as such: service_name:user_name:service_specific_credential_id"
  value       = element(concat(aws_iam_service_specific_credential.iam_service_specific_credential.*.id, [""]), 0)
}
output "iam_service_specific_credential_service_password" {
  description = "The generated password for the service-specific credential. This value is only available when the credential is created"
  value       = element(concat(aws_iam_service_specific_credential.iam_service_specific_credential.*.service_password, [""]), 0)
}
output "iam_service_specific_credential_service_user_name" {
  description = "The generated user name for the service-specific credential. This value is generated by combining the IAM user's name combined with the ID number of the AWS account, as in jane-at-123456789012 for example"
  value       = element(concat(aws_iam_service_specific_credential.iam_service_specific_credential.*.service_user_name, [""]), 0)
}
output "iam_service_specific_credential_service_specific_credential_id" {
  description = "The unique identifier for the service-specific credential"
  value       = element(concat(aws_iam_service_specific_credential.iam_service_specific_credential.*.service_specific_credential_id, [""]), 0)
}
output "iam_service_specific_credential_service_credential_alias" {
  description = "For Bedrock API keys, this is the public portion of the credential that includes the IAM user name and a suffix containing version and creation information"
  value       = element(concat(aws_iam_service_specific_credential.iam_service_specific_credential.*.service_credential_alias, [""]), 0)
}
output "iam_service_specific_credential_service_credential_secret" {
  description = "For Bedrock API keys, this is the secret portion of the credential that should be used to authenticate API calls. This value is only available when the credential is created"
  value       = element(concat(aws_iam_service_specific_credential.iam_service_specific_credential.*.service_credential_secret, [""]), 0)
}
output "iam_service_specific_credential_create_date" {
  description = "The date and time, in RFC3339 format, when the service-specific credential was created"
  value       = element(concat(aws_iam_service_specific_credential.iam_service_specific_credential.*.create_date, [""]), 0)
}
output "iam_service_specific_credential_expiration_date" {
  description = "The date and time, in RFC3339 format, when the service specific credential expires. This field is only present for Bedrock API keys that were created with an expiration period"
  value       = element(concat(aws_iam_service_specific_credential.iam_service_specific_credential.*.expiration_date, [""]), 0)
}
