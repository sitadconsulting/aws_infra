variable "iam_saml_provider_name" {
  description = "(Required) The name of the provider to create"
  type        = string
}
variable "iam_saml_provider_saml_metadata_document" {
  description = "(Required) An XML document generated by an identity provider that supports SAML 2.0"
  type        = string
}
variable "iam_saml_provider_tags" {
  description = "(Optional) Map of resource tags for the IAM SAML provider"
  type        = map(string)
  default     = {}
}
