output "cloudwatchomni_view_arn" {
  description = "ARN of the view. Contains an identifier generated by CloudWatch, in the form arn:aws:cloudwatch:<region>:<account>:view/<name>/<id>"
  value       = element(concat(aws_cloudwatchomni_view.cloudwatchomni_view.*.arn, [""]), 0)
}
output "cloudwatchomni_view_type" {
  description = "Type of the view. Views created with Terraform are USER views"
  value       = element(concat(aws_cloudwatchomni_view.cloudwatchomni_view.*.type, [""]), 0)
}
