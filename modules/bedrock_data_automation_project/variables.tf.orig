variable "bedrock_data_automation_project_kms_encryption_context" {
  description = "The AWS KMS encryption context to use for encryption"
  type        = map(string)
  default     = null
}
variable "bedrock_data_automation_project_kms_key_id" {
  description = "The AWS KMS key to use for encryption"
  type        = string
  default     = null
}
variable "bedrock_data_automation_project_project_description" {
  description = "The project description"
  type        = string
  default     = null
}
variable "bedrock_data_automation_project_name" {
  description = "The project name"
  type        = string
  default     = null
}
variable "bedrock_data_automation_project_type" {
  description = "The project type, allowed values: ASYNC | SYNC"
  type        = string
  default     = null
}
variable "bedrock_data_automation_project_tags" {
  description = "A map of tags to assign to the project resource"
  type        = list(object({
    key   = optional(string)
    value = optional(string)
  }))
  default     = null
}
#variable "bedrock_data_automation_project_custom_output_configuration" {
#  description = "Blueprints to apply to objects processed by the project"
#  type        = list(object({
#    blueprint_arn     = string
#    blueprint_stage   = optional(string)
#    blueprint_version = optional(string)
#  }))
#  default     = []
#}
variable "bedrock_data_automation_project_custom_output_configuration_blueprints" {
  description = "Blueprints to apply to objects processed by the project"
  type       = list(object({
    blueprint_arn     = string
    blueprint_stage   = optional(string)
    blueprint_version = optional(string)
  }))
  default     = []
}
variable "bedrock_data_automation_project_override_configuration_audio_language_configuration_generative_output_language" {
  description = "Generative output language. One of 'DEFAULT', 'EN'"
  type        = string
  default     = "EN"
}
variable "bedrock_data_automation_project_override_configuration_audio_language_configuration_identify_multiple_languages" {
  description = "Whether to identify multiple languages"
  type        = bool
  default     = true
}
variable "bedrock_data_automation_project_override_configuration_audio_language_configuration_input_languages" {
  description = "List of languages to identity. set if identify multiple languages is set to true"
  type        = list(string)
  default     = [ "EN", "FR", "IT", "PT", "JA", "KO", "CN", "TW", "HK", ]
}
variable "bedrock_data_automation_project_override_configuration_audio_modality_processing_state" {
  description = "Whether to enable audio modalility processing. One of 'ENABLED', 'DISABLED'"
  type        = string
  default     = "ENABLED"
}
variable "bedrock_data_automation_project_override_configuration_audio_sensitive_data_configuration_detection_mode" {
  description = "Whether to enable detection of audio sensitive data. One of 'DETECTION', 'DETECTION_AND_REDACTION'"
  type        = string
  default     = "DETECTION"
}
variable "bedrock_data_automation_project_override_configuration_audio_sensitive_data_configuration_detection_scope" {
  description = "Scope of sensitive audo data detection. One of 'STANDARD', 'CUSTOM'"
  type        = list(string)
  default     = [ "STANDARD", ]
}
variable "bedrock_data_automation_project_override_configuration_audio_sensitive_data_configuration_pii_entities_configuration_pii_entity_types" {
  description = "List of audio pii entity types to detect"
  type        = list(string) 
  default     = null
}
variable "bedrock_data_automation_project_override_configuration_audio_sensitive_data_configuration_pii_entities_configuration_redaction_mask_mode" {
  description = "Set audio sensitive data redaction mask mode. One of 'PII', 'ENTITY_TYPE'" 
  type        = string
  default     = null
}
variable "bedrock_data_automation_project_override_configuration_document_modality_processing_state" {
  description = "Whether to enable or disable document modality processing. One of 'ENABLED', 'DISABLED'"
  type        = string
  default     = "ENABLED"
}
variable "bedrock_data_automation_project_override_configuration_document_sensitive_data_configuration_detection_mode" {
  description = "Whether to enable detection of document sensitive data. One of 'DETECTION', 'DETECTION_AND_REDACTION'"
  type        = string
  default     = "DETECTION"
}
variable "bedrock_data_automation_project_override_configuration_document_sensitive_data_configuration_detection_scope" {
  description = "Scope of sensitive document data detection. One of 'STANDARD', 'CUSTOM'"
  type        = list(string)
  default     = [ "STANDARD", "CUSTOM" ]
}
variable "bedrock_data_automation_project_override_configuration_document_sensitive_data_configuration_pii_entities_configuration_pii_entity_types" {
  description = "List of document pii entity types to detect"
  type        = list(string) 
  default     = null
}
variable "bedrock_data_automation_project_override_configuration_document_sensitive_data_configuration_pii_entities_configuration_redaction_mask_mode" {
  description = "Set document sensitive data redaction mask mode. One of 'PII', 'ENTITY_TYPE'" 
  type        = string
  default     = null
}
variable "bedrock_data_automation_project_override_configuration_document_splitter_state" {
  description = "Whether to enable or disable document splitting. One of 'ENABLED', 'DISABLED'"
  type        = string
  default     = "ENABLED"
}
variable "bedrock_data_automation_project_override_configuration_image_modality_processing_state" {
  description = "Whether to enable image modalility processing. One of 'ENABLED', 'DISABLED'"
  type        = string
  default     = "ENABLED"
}
variable "bedrock_data_automation_project_override_configuration_image_sensitive_data_configuration_detection_mode" {
  description = "Whether to enable detection of image sensitive data. One of 'DETECTION', 'DETECTION_AND_REDACTION'"
  type        = string
  default     = "DETECTION"
}
variable "bedrock_data_automation_project_override_configuration_image_sensitive_data_configuration_detection_scope" {
  description = "Scope of sensitive image data detection. One of 'STANDARD', 'CUSTOM'"
  type        = list(string)
  default     = [ "STANDARD", ]
}
variable "bedrock_data_automation_project_override_configuration_image_sensitive_data_configuration_pii_entities_configuration_pii_entity_types" {
  description = "List of image pii entity types to detect"
  type        = list(string) 
  default     = null
}
variable "bedrock_data_automation_project_override_configuration_image_sensitive_data_configuration_pii_entities_configuration_redaction_mask_mode" {
  description = "Set image sensitive data redaction mask mode. One of 'PII', 'ENTITY_TYPE'" 
  type        = string
  default     = null
}
variable "bedrock_data_automation_project_override_configuration_modality_routing_jpeg" {
  description = "Set modality routing for jpeg media type. One of 'DOCUMENT', 'IMAGE', 'VIDEO', 'AUDIO'"
  type        = string
  default     = "IMAGE"
}
variable "bedrock_data_automation_project_override_configuration_modality_routing_mov" {
  description = "Set modality routing for mov media type. One of 'DOCUMENT', 'IMAGE', 'VIDEO', 'AUDIO'"
  type        = string
  default     = "VIDEO"
}
variable "bedrock_data_automation_project_override_configuration_modality_routing_mp_4" {
  description = "Set modality routing for mp_4 media type. One of 'DOCUMENT', 'IMAGE', 'VIDEO', 'AUDIO'"
  type        = string
  default     = "VIDEO"
}
variable "bedrock_data_automation_project_override_configuration_modality_routing_png" {
  description = "Set modality routing for png media type. One of 'DOCUMENT', 'IMAGE', 'VIDEO', 'AUDIO'"
  type        = string
  default     = "DOCUMENT"
}
variable "bedrock_data_automation_project_override_configuration_video_modality_processing_state" {
  description = "Whether to enable video modalility processing. One of 'ENABLED', 'DISABLED'"
  type        = string
  default     = "ENABLED"
}
variable "bedrock_data_automation_project_override_configuration_video_sensitive_data_configuration_detection_mode" {
  description = "Whether to enable detection of video sensitive data. One of 'DETECTION', 'DETECTION_AND_REDACTION'"
  type        = string
  default     = "DETECTION"
}
variable "bedrock_data_automation_project_override_configuration_video_sensitive_data_configuration_detection_scope" {
  description = "Scope of sensitive video data detection. One of 'STANDARD', 'CUSTOM'"
  type        = list(string)
  default     = [ "STANDARD", ]
}
variable "bedrock_data_automation_project_override_configuration_video_sensitive_data_configuration_pii_entities_configuration_pii_entity_types" {
  description = "List of video pii entity types to detect"
  type        = list(string) 
  default     = null
}
variable "bedrock_data_automation_project_override_configuration_video_sensitive_data_configuration_pii_entities_configuration_redaction_mask_mode" {
  description = "Set video sensitive data redaction mask mode. One of 'PII', 'ENTITY_TYPE'" 
  type        = string
  default     = null
}
variable "bedrock_data_automation_project_standard_output_configuration_audio_extraction_category_state" {
  description = "Whether to enable or disable audio extraction category. One of 'ENABLED', 'DISABLED'"
  type        = string
  default     = "ENABLED"
}
variable "bedrock_data_automation_project_standard_output_configuration_audio_extraction_category_types" {
  description = "List of audio extraction category types. One of 'AUDIO_CONTENT_MODERATION', 'TRANSCRIPT', 'TOPIC_CONTENT_MODERATION'"
  type        = list(string)
  default     = [ "TRANSCRIPT", ]
}
variable "bedrock_data_automation_project_standard_output_configuration_audio_extraction_category_type_configuration_transcript_channel_labeling_state" {
  description = "Whether to enable or disable audio extraction category transcript channel labeling. One of 'ENABLED', 'DISABLED'"
  type        = string
  default     = "ENABLED"
}
variable "bedrock_data_automation_project_standard_output_configuration_audio_extraction_category_type_configuration_speaker_labeling_state" {
  description = "Whether to enable or disable audio extraction category speaker labeling. One of 'ENABLED', 'DISABLED'"
  type        = string
  default     = "ENABLED"
}
variable "bedrock_data_automation_project_standard_output_configuration_audio_generative_field_state" {
  description = "Whether to enable or disable genrative ai field audio processing. One of 'ENABLED', 'DISABLED'"
  type        = string
  default     = "ENABLED" 
}
variable "bedrock_data_automation_project_standard_output_configuration_audio_generative_field_types" {
  description = "List of generative ai fields audio processing to configure. One of 'AUDIO_SUMMARY', 'IAB', 'TOPIC_SUMMARY'"
  type        = list(string)
  default     = [ "AUDIO_SUMMARY", "IAB", "TOPIC_SUMMARY" ]
}
variable "bedrock_data_automation_project_standard_output_configuration_document_extraction_bounding_box_state" {
  description = "Whether to enable or disable document extraction bounding box. One of 'ENABLED', 'DISABLED'"
  type        = string
  default     = "ENABLED"
}
variable "bedrock_data_automation_project_standard_output_configuration_document_extraction_granularity_types" {
  description = "List of extracted document granularity type. One of 'DOCUMENT', 'PAGE', 'ELEMENT', 'WORD', 'LINE'" 
  type        = list(string)
  default     = [ "DOCUMENT", "PAGE", "ELEMENT", "LINE",  ]
}
variable "bedrock_data_automation_project_standard_output_configuration_document_generative_field_state" {
  description = "Whether to enable or disable genrative ai field for document processing. One of 'ENABLED', 'DISABLED'"
  type        = string
  default     = "ENABLED"
}
variable "bedrock_data_automation_project_standard_output_configuration_document_output_format_additional_file_format_state" {
  description = "Whether to enable or disable document output format additional file format output. One of 'ENABLED', 'DISABLED'"
  type        = string
  default     = "ENABLED"
}
variable "bedrock_data_automation_project_standard_output_configuration_document_output_format_text_format_types" {
  description = "List of document output format text output format. One of 'PLAIN_TEXT', 'MARKDOWN', 'HTML', 'CSV'"
  type        = list(string)
  default     = [ "MARKDOWN", "CSV", ]
}
variable "bedrock_data_automation_project_standard_output_configuration_image_extraction_bounding_box_state" {
  description = "Whether to enable of disable image extraction bounding box. One of 'ENABLED', 'DISABLED'"
  type        = string
  default     = "ENABLED"
}
variable "bedrock_data_automation_project_standard_output_configuration_image_extraction_category_state" {
  description = "Whether to enable or disable image extraction category. One of 'ENABLED', 'DISABLED'"
  type        = string
  default     = "ENABLED"
}
variable "bedrock_data_automation_project_standard_output_configuration_image_extraction_category_types" {
  description = "List of image extraction category types. One of 'CONTENT_MODERATION', 'TEXT_DETECTION', 'LOGOS'"
  type        = list(string)
  default     = [ "CONTENT_MODERATION", "TEXT_DETECTION", "LOGOS" ]
}
variable "bedrock_data_automation_project_standard_output_configuration_image_generative_field_state" {
  description = "Whether to enable or disable genrative ai field image processing. One of 'ENABLED', 'DISABLED'"
  type        = string
  default     = "ENABLED" 
}
variable "bedrock_data_automation_project_standard_output_configuration_image_generative_field_types" {
  description = "List of generative ai fields image processing to configure. One of 'IMAGE_SUMMARY', 'IAB'"
  type        = list(string)
  default     = [ "IMAGE_SUMMARY", "IAB", ]
}
variable "bedrock_data_automation_project_standard_output_configuration_video_extraction_bounding_box_state" {
  description = "Whether to enable of disable video extraction bounding box. One of 'ENABLED', 'DISABLED'"
  type        = string
  default     = "ENABLED"
}
variable "bedrock_data_automation_project_standard_output_configuration_video_extraction_category_state" {
  description = "Whether to enable or disable video extraction category. One of 'ENABLED', 'DISABLED'"
  type        = string
  default     = "ENABLED"
}
variable "bedrock_data_automation_project_standard_output_configuration_video_extraction_category_types" {
  description = "List of video extraction category types. One of 'CONTENT_MODERATION', 'TEXT_DETECTION', 'TRANSCRIPT', 'LOGOS'"
  type        = list(string)
  default     = [ "CONTENT_MODERATION", "TEXT_DETECTION", "TRANSCRIPT", "LOGOS" ]
}
variable "bedrock_data_automation_project_standard_output_configuration_video_generative_field_state" {
  description = "Whether to enable or disable genrative ai field video processing. One of 'ENABLED', 'DISABLED'"
  type        = string
  default     = "ENABLED" 
}
variable "bedrock_data_automation_project_standard_output_configuration_video_generative_field_types" {
  description = "List of generative ai fields video processing to configure. One of 'VIDEO_SUMMARY', 'IAB', 'CHAPTER_SUMMARY'"
  type        = list(string)
  default     = [ "VIDEO_SUMMARY", "IAB", "CHAPTER_SUMMARY" ]
}
