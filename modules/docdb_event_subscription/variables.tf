variable "docdb_event_subscription_enabled" {
  description = "(Optional) A boolean flag to enable/disable the subscription. Defaults to true"
  type        = bool
  default     = true
}
variable "docdb_event_subscription_event_categories" {
  description = "(Optional) A list of event categories for a SourceType that you want to subscribe to. See https://docs.aws.amazon.com/documentdb/latest/developerguide/API_Event.html or run aws docdb describe-event-categories"
  type        = list(string)
  default     = null
}
variable "docdb_event_subscription_name" {
  description = "(Optional) The name of the DocumentDB event subscription. By default generated by Terraform"
  type        = string
  default     = null
}
variable "docdb_event_subscription_name_prefix" {
  description = "(Optional) The name of the DocumentDB event subscription. Conflicts with name"
  type        = string
  default     = null
}
variable "docdb_event_subscription_sns_topic" {
  description = "(Required) The SNS topic to send events to"
  type        = string
}
variable "docdb_event_subscription_source_ids" {
  description = "(Optional) A list of identifiers of the event sources for which events will be returned. If not specified, then all sources are included in the response. If specified, a source_type must also be specified"
  type        = list(string)
  default     = null
}
variable "docdb_event_subscription_source_type" {
  description = "(Optional) The type of source that will be generating the events. Valid options are db-instance, db-cluster, db-parameter-group, db-security-group, db-cluster-snapshot. If not set, all sources will be subscribed to."
  type        = string
  default     = null
}
